# Ejemplo de configuración de variables de entorno para el frontend
# Copia este archivo a .env y reemplaza los valores

# URL de Calendly - Reemplaza con tu URL real después de crear tu cuenta
# Ejemplo: https://calendly.com/afyl-legal/consulta-30min
REACT_APP_CALENDLY_URL=https://calendly.com/tu-usuario/tu-evento

# URL del API Backend
REACT_APP_API_URL=http://localhost:5000
